# Copy to terraform.tfvars. Every apply and destroy then uses the same Region.
region = "eu-west-1"

# Lower this for short tests, to keep less CloudWatch Logs storage.
log_retention_days = 365

# Only for browser uploads to the presigned URLs. API and CLI clients need none.
# cors_allowed_origins = ["https://portal.example.com"]

